<Window x:Class="Conferencia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Conferencia"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800">
    <Grid Background="#F5F7FA">
        <!-- Карточка формы по центру -->
        <Border Background="White"
            Width="400"
            CornerRadius="10"
            Padding="32"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#DEE2E6"
            BorderThickness="1">

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Портал «Конференции.РФ»"
                       FontSize="13"
                       Foreground="#6C757D"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="Авторизация"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#212529"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,24"/>

                <!-- Логин -->
                <TextBlock Text="Логин"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="loginTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,16"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="passwordTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,22"/>

                <!-- Кнопка входа -->
                <Button Content="Вход"
                    Click="Button_Click"
                    Height="40"
                    Background="#0D6EFD"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,18"/>

                <!-- Ссылка на регистрацию -->
                <TextBlock HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="#495057">
                <Run Text="Еще не зарегистрированы? "/>
                <Hyperlink Click="OpenRegistration_Click"
                           Foreground="#0D6EFD"
                           TextDecorations="None">
                    <Run Text="Регистрация" FontWeight="SemiBold"/>
                </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
