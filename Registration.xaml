<Window x:Class="Conferencia.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Conferencia"
        mc:Ignorable="d"
        Title="Регистрация" Height="450" Width="800">
    <Grid Background="#F5F7FA">
        <!-- Карточка формы строго по центру -->
        <Border Background="White"
            Width="440"
            CornerRadius="10"
            Padding="32"
            Margin="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderBrush="#DEE2E6"
            BorderThickness="1">

            <StackPanel>
                <!-- Заголовок -->
                <TextBlock Text="Портал «Конференции.РФ»"
                       FontSize="13"
                       Foreground="#6C757D"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="Регистрация"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#212529"
                       HorizontalAlignment="Center"
                       Margin="0,2,0,22"/>

                <!-- Логин -->
                <TextBlock Text="Логин (латиница и цифры, от 6 символов) *"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="loginTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,14"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль (минимум 8 символов) *"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="passwordTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,14"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО (кириллица и пробелы) *"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="FIOTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,14"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон (формат: 8(XXX)XXX-XX-XX) *"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="phoneNumberTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,14"/>

                <!-- Электронная почта -->
                <TextBlock Text="Адрес электронной почты *"
                       FontWeight="SemiBold"
                       Foreground="#343A40"
                       Margin="0,0,0,5"/>
                <TextBox x:Name="mailAddressTextbox"
                     Height="36"
                     Padding="10,7"
                     FontSize="14"
                     BorderBrush="#CED4DA"
                     Margin="0,0,0,20"/>

                <!-- Кнопка регистрации -->
                <Button Content="Зарегистрироваться"
                    Click="Button_Click"
                    Height="40"
                    Background="#0D6EFD"
                    Foreground="White"
                    FontSize="15"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Margin="0,0,0,16"/>

                <!-- Ссылка на авторизацию -->
                <TextBlock HorizontalAlignment="Center"
                       FontSize="13"
                       Foreground="#495057">
                <Run Text="Вы уже зарегистрированы? "/>
                <Hyperlink Click="OpenAuthorization_Click"
                           Foreground="#0D6EFD"
                           TextDecorations="None">
                    <Run Text="Авторизуйтесь" FontWeight="SemiBold"/>
                </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
